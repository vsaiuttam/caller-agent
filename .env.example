# ---------------------------------------------------------------------------
# Model provider. Set exactly one key and the app uses it; set several and
# MODEL_PROVIDER picks. Placeholder values like the ones below are recognised
# as unset rather than counted as configured.
#
#   anthropic  Claude. Prompt caching with explicit breakpoints.
#   gemini     97 languages incl. Hindi and Urdu; cheapest of the four.
#   openai     Realtime speech-to-speech and SIP telephony from one key.
#   sarvam     Indic-first; the strongest option for code-mixed Hinglish.
#   nvidia     Free evaluation credits, 40 req/min. Not for campaigns.
# ---------------------------------------------------------------------------
# MODEL_PROVIDER=gemini

ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=            # https://aistudio.google.com
# OPENAI_API_KEY=            # https://platform.openai.com
# SARVAM_API_KEY=            # https://dashboard.sarvam.ai
# NVIDIA_API_KEY=            # https://build.nvidia.com

# Signs outbound webhooks with X-Rumik-Signature (HMAC-SHA256). Without it we
# still deliver, but the receiver cannot tell our POST from anyone else's.
WEBHOOK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Storage. SQLite is fine for development; use Postgres at volume — SQLite's
# single-writer lock will serialise the runner's contact claims.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./voiceagent.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/voiceagent

# ---------------------------------------------------------------------------
# Telephony: "mock" (scripted caller, no phone line) or "livekit" (real calls)
# ---------------------------------------------------------------------------
TELEPHONY=mock
MOCK_ANSWER_RATE=0.8
MOCK_INTERRUPT=false

# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_SIP_TRUNK_ID=
# CALLER_ID_E164=+14155550100

# Speech. Only needed when TELEPHONY=livekit or for Sarvam voice.
# VOICE_PROVIDER=deepgram          # "deepgram" (default) or "sarvam"
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=

# Sarvam AI voice — Indic-first STT (Saarika) and TTS (Bulbul).
# Set VOICE_PROVIDER=sarvam to use Sarvam TTS on Twilio calls and
# Sarvam STT+TTS on LiveKit calls.
# SARVAM_STT_LANGUAGE=hi-IN        # language for speech-to-text
# SARVAM_TTS_LANGUAGE=hi-IN        # language for text-to-speech
# SARVAM_TTS_SPEAKER=meera         # voice: meera, arvind, etc.

# ---------------------------------------------------------------------------
# Post-call integrations. Unset values fall back to mocks that log instead of
# writing, so the pipeline runs end to end before these exist.
# ---------------------------------------------------------------------------
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CREDENTIALS_PATH=./service-account.json
# RECORDS_API_URL=https://internal.example.com/api
# RECORDS_API_KEY=

# ---------------------------------------------------------------------------
# Twilio (alternative telephony — set TELEPHONY=twilio to use)
# ---------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# TWILIO_WEBHOOK_URL=https://your-app.onrender.com   # public base URL (https)

# Turn-taking. Defaults are fine; these are the knobs if replies feel slow.
# TWILIO_SPEECH_MODEL=               # e.g. experimental_conversations, googlev2_telephony
# TWILIO_SPEECH_TIMEOUT=auto         # or seconds of silence that end the caller's turn
# TWILIO_GATHER_TIMEOUT=10           # seconds to wait for the caller to start talking
# TWILIO_REPLY_WAIT=9                # seconds a webhook holds for the reply (Twilio's cap is 15)
# SARVAM_TWILIO_SAMPLE_RATE=8000     # phone lines carry 8 kHz; bigger is just a slower download

# Follow-up messages after each call (toggled per campaign). SMS uses the
# number above. WhatsApp needs its own sender — for testing, the Twilio
# Sandbox (+14155238886): message its join code from your WhatsApp first.
# TWILIO_WHATSAPP_FROM=+14155238886
# Outside the Sandbox, WhatsApp only accepts business-initiated messages from
# an approved template. Create one shaped "Hi {{1}}, {{2}} — {{3}}" in the
# Twilio Content Template Builder and put its HX... SID here.
# TWILIO_WHATSAPP_CONTENT_SID=

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
